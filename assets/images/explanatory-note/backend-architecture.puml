@startuml

skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam componentStyle uml2
skinparam linetype ortho
skinparam ComponentBackgroundColor white

top to bottom direction

package "API-слой" {
  component "Маршруты HTTP API\n\nAuth · Salon · Services · Staff\nVisits · Bot · Notifications · Health" as api
}

package "Прикладной слой" {
  component "Прикладные сервисы\n\nAuthService · CrmIdentityService\nSalonService · ServicesService\nStaffService · VisitsService\nBotStatusService · NotificationService" as services
}

package "Инфраструктурный слой" {
  component "Адаптеры внешних API\n\nCrmAdapter\nMessengerAdapter" as adapters
  component "PostgreSQL-репозитории\n\nUserRepository" as postgres_repositories <<repository>>
  component "Redis-репозитории\n\nSessionRepository\nBotConfigRepository\nBotStatusRepository" as redis_repositories <<repository>>
  component "Публикация уведомлений\n\nNotificationStreamPublisher" as notifications
}

package "Схемы и доменная модель" {
  component "Pydantic-схемы и ошибки\n\nКлиентские схемы · Схемы CRM\nДоменные ошибки" as schemas
}

api -down-> services : вызывает
services -down-> adapters : обращается к внешним API
services -down-> postgres_repositories : хранит пользователей
services -down-> redis_repositories : управляет временным состоянием
services -down-> notifications : публикует уведомления
adapters -down-> schemas : преобразует ответы CRM
postgres_repositories -down-> schemas
redis_repositories -down-> schemas
notifications -down-> schemas
@enduml
