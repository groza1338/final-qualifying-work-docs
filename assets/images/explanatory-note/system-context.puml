@startuml

skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam componentStyle uml2
skinparam ComponentBackgroundColor white

left to right direction

component "Telegram-бот" as bot
component "Mini App" as mini

package "Система онлайн-записи" {
  component "Серверный модуль" as backend
  database "PostgreSQL" as postgres
  database "Redis" as redis
}

component "CRM-система" as crm <<внешняя система>>
component "Messenger API" as messenger <<внешний сервис>>

bot -down-> mini : запуск
mini --> backend : HTTP API
backend ..> crm : CRM API
backend ..> messenger : сведения о боте
backend ..> postgres : профили и внешние\nидентичности
backend ..> redis : сессии, кэш,\nстатусы, уведомления
@enduml
