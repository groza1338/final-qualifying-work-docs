@startuml

skinparam monochrome true

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam ParticipantBackgroundColor white

participant "Мини-приложение" as mini
participant "Серверный модуль" as backend
database "Redis" as redis
database "PostgreSQL" as postgres
participant "CRM-система" as crm

mini -> backend : Создать запись\n(услуга, мастер, время)
backend -> redis : Проверить сессию
redis --> backend : Данные локального пользователя
backend -> postgres : Получить профиль и связь с CRM
postgres --> backend : Профиль и crm_id
backend -> crm : Подписанный запрос создания записи
crm --> backend : Созданная запись и идентификатор клиента
backend -> postgres : Сохранить связь с клиентом CRM
postgres --> backend : Связь сохранена
backend --> mini : Запись в формате клиентского приложения
@enduml
